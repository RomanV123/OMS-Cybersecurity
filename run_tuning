import pandas as pd
from sklearn.ensemble import GradientBoostingClassifier
from sklearn.impute import SimpleImputer
from sklearn.model_selection import GridSearchCV, StratifiedKFold, train_test_split
from sklearn.pipeline import Pipeline

from src.task5 import extract_url_features

TUNE_PHIUSIIL = False   # already tuned; set True to redo it (takes a minute or two)


def load_train_split(path):
    full_df = pd.read_csv(path)
    train_df, _ = train_test_split(full_df, test_size=0.20, random_state=0, stratify=full_df["label"])
    return train_df


def run_search(model, param_grid, features, labels):
    search = GridSearchCV(
        model, param_grid, scoring="roc_auc",
        cv=StratifiedKFold(n_splits=3, shuffle=True, random_state=0), n_jobs=-1,
    )
    search.fit(features, labels)
    print("  best params:", search.best_params_)
    print("  best CV AUC:", round(search.best_score_, 4), flush=True)


# ---- UNSW ----
print("UNSW: running grid search...", flush=True)
train_df = load_train_split(r".\task5\UNSW_Train.csv")
drop_cols = ["label"] + [c for c in train_df.columns if c.startswith("Unnamed") or c == "id"]
unsw_model = Pipeline([
    ("imp", SimpleImputer(strategy="median", keep_empty_features=True)),
    ("gb", GradientBoostingClassifier(subsample=0.8, random_state=0)),
])
unsw_grid = {
    "gb__n_estimators": [100, 200, 400],
    "gb__learning_rate": [0.02, 0.05, 0.1],
    "gb__max_depth": [3, 5, 7],
    "gb__min_samples_leaf": [1, 20, 50],
}
run_search(unsw_model, unsw_grid, train_df.drop(columns=drop_cols), train_df["label"])

# ---- PhiUSIIL ----
if TUNE_PHIUSIIL:
    print("\nPhiUSIIL: running grid search...", flush=True)
    train_df = load_train_split(r".\task5\PhiUSIIL_Train.csv")
    url_col = "URL" if "URL" in train_df.columns else [c for c in train_df.columns if c != "label"][0]
    phi_grid = {
        "n_estimators": [100, 200],
        "learning_rate": [0.05, 0.1],
        "max_depth": [3, 5],
    }
    run_search(GradientBoostingClassifier(subsample=0.8, random_state=0), phi_grid,
               extract_url_features(train_df[url_col]), train_df["label"])